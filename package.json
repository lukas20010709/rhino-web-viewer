{
  "name": "rhino-web-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Rhino → GLB+JSON → Three.js Web 3D Viewer (Public repo, GitHub Pages)",
  "type": "module",
  "scripts": {
    "copy:decoders": "node scripts/copy-decoders.mjs",
    "predev": "node scripts/copy-decoders.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-decoders.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-model.mjs public/projects/project-a",
    "demo:glb": "node scripts/make-demo-glb.mjs public/projects/project-a",
    "publish:model": "node scripts/publish-model.mjs",
    "bootstrap:github": "node scripts/bootstrap-github.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "@gltf-transform/core": "^4.0.0",
    "@gltf-transform/extensions": "^4.0.0",
    "@gltf-transform/functions": "^4.0.0",
    "ajv": "^8.17.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
