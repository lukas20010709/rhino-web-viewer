{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/rhino-web-viewer/schemas/manifest.schema.json",
  "title": "Model Manifest",
  "description": "1プロジェクト1リビジョンの読み込み単位を宣言する。Viewer/CI/Publisherが共有する唯一の入口契約。",
  "type": "object",
  "required": ["schemaVersion", "project", "revision", "unit", "parts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "このマニフェストスキーマのバージョン (semver)。",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "string",
      "description": "プロジェクト識別子 (public/projects/<project>/ と一致)。",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "revision": {
      "type": "string",
      "description": "リビジョンID。日付連番 (例 2026-09-09-01)。metadata.json の revision と一致させる。"
    },
    "title": {
      "type": "string",
      "description": "Viewer表示用の人間可読名。"
    },
    "unit": {
      "type": "string",
      "description": "モデルの長さ単位。建築は既定 mm。",
      "enum": ["mm", "cm", "m", "in", "ft"]
    },
    "up": {
      "type": "string",
      "description": "GLBの上方向軸。Rhino Z-up を glTF Y-up に変換済みであること。",
      "enum": ["Y", "Z"],
      "default": "Y"
    },
    "origin": {
      "type": "string",
      "description": "origin.json への相対パス。世界座標復元に使用。",
      "default": "origin.json"
    },
    "metadata": {
      "type": "string",
      "description": "metadata.json への相対パス。",
      "default": "metadata.json"
    },
    "thumbnail": {
      "type": "string",
      "description": "サムネイル画像への相対パス (webp)。"
    },
    "parts": {
      "type": "array",
      "description": "段階ロードするGLB分割単位。単一GLBにしない方針の実装点。",
      "minItems": 1,
      "items": { "$ref": "#/definitions/part" }
    },
    "createdAt": {
      "type": "string",
      "description": "生成時刻 (ISO 8601)。Publisherが付与。"
    }
  },
  "definitions": {
    "part": {
      "type": "object",
      "required": ["id", "file", "loadPriority"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "分割単位ID。レイヤー系統に対応 (site/structure/architecture/furniture/equipment/landscape)。",
          "enum": ["site", "structure", "architecture", "furniture", "equipment", "landscape"]
        },
        "file": {
          "type": "string",
          "description": "GLBファイルへの相対パス。",
          "pattern": "\\.glb$"
        },
        "loadPriority": {
          "type": "integer",
          "description": "ロード順。小さいほど先に読む (1が最優先)。",
          "minimum": 1
        },
        "defaultVisible": {
          "type": "boolean",
          "description": "初期表示ON/OFF。",
          "default": true
        },
        "sizeBytes": {
          "type": "integer",
          "description": "GLBサイズ (bytes)。容量ゲート判定に使用。",
          "minimum": 0
        },
        "drawCallHint": {
          "type": "integer",
          "description": "想定Draw Call数 (任意, 性能ゲートの参考)。",
          "minimum": 0
        },
        "triangleCount": {
          "type": "integer",
          "description": "三角形数 (任意, 品質ゲートの参考)。",
          "minimum": 0
        }
      }
    }
  }
}
